---
import '../styles/site.css';
const { title = 'Reviiv Motors | Revive Your Drive | Used Cars in Mississauga', description = 'Explore pre-owned vehicles at Reviiv Motors in Mississauga. Buy, sell, trade and ask about financing options.' } = Astro.props;
const phone = '416-346-9568';
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08060e" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, "https://reviivmotors.ca/")} />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="top-strip">
      <div class="wrap strip-inner">
        <span>MISSISSAUGA, ONTARIO</span>
        <a href={`tel:+14163469568`}>Call us: {phone}</a>
      </div>
    </div>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo-link" href="/" aria-label="Reviiv Motors home">
          <img src="/reviiv-logo-poster.png" alt="Reviiv Motors" width="925" height="630" />
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="/inventory/">Inventory</a>
          <a href="/what-we-offer/">What We Offer</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </nav>
        <a class="header-call" href="tel:+14163469568">Call Now <span aria-hidden="true">↗</span></a>
        <details class="mobile-menu">
          <summary aria-label="Open navigation menu">Menu <span aria-hidden="true">☰</span></summary>
          <nav aria-label="Mobile navigation">
            <a href="/inventory/">Inventory</a>
            <a href="/what-we-offer/">What We Offer</a>
            <a href="/#about">About</a>
            <a href="/#contact">Contact</a>
            <a href="tel:+14163469568">Call Us</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content"><slot /></main>

    <footer class="footer">
      <div class="wrap footer-main">
        <a class="footer-logo" href="/" aria-label="Reviiv Motors home"><img src="/reviiv-logo-poster.png" alt="Reviiv Motors" width="925" height="630" loading="lazy" /></a>
        <p>REVIVE YOUR DRIVE.<br /><span>BUY · SELL · TRADE · FINANCE</span></p>
        <a href="#main-content" class="back-top">BACK TO TOP ↑</a>
      </div>
      <div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Reviiv Motors. All rights reserved.</span><span>Mississauga, Ontario</span></div>
    </footer>
  </body>
</html>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => { menu.open = false; });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
