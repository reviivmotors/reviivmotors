---
import Icon from '../components/Icon.astro';
import DriveReveal from '../components/DriveReveal.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import BodyTypeLinks from '../components/BodyTypeLinks.astro';
import { phone, email } from '../data/inventory.ts';
import { openingHours } from '../data/business.ts';
const hasOpeningHours = openingHours.some(({ hours }) => hours !== null);
---

<SiteLayout>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-glow"></div>
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-dot"></span> REVIIV MOTORS · MISSISSAUGA</p>
            <h1 id="hero-title">REVIVE<br /><em>YOUR DRIVE.</em></h1>
            <p class="hero-description">Your next chapter starts behind the wheel. Explore pre-owned vehicles and discover a more personal way to buy, sell, trade, and finance.</p>
            <div class="hero-cta">
              <div class="hero-actions">
                <a class="btn btn-primary" href="/inventory/">Explore Inventory <span aria-hidden="true"><Icon /></span></a>
                <a class="btn btn-outline" href="#contact">Get in Touch</a>
              </div>
              <p class="hero-strap">BUY <span>·</span> SELL <span>·</span> TRADE <span>·</span> FINANCE</p>
            </div>
          </div>
          <div class="hero-media">
            <img src="/gtr-hero.webp" alt="Rear view of a Nissan GT-R illuminated in Reviiv purple" width="1088" height="741" fetchpriority="high" />
            <div class="image-caption">THE DRIVE IS EVERYTHING <span><Icon /></span></div>
          </div>
        </div>
        <div class="wrap hero-bottom"><span>01 / REVIVE YOUR DRIVE</span><a href="/inventory/">EXPLORE THE COLLECTION <Icon name="arrow-down" /></a></div>
      </section>

      <section id="inventory" class="section body-type-section" aria-labelledby="body-type-title">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <p class="kicker">FIND YOUR FIT</p>
              <h2 id="body-type-title">Browse by <span>Body Type.</span></h2>
              <p class="section-intro">From everyday essentials to your next adventure. Choose a body type to explore our inventory.</p>
            </div>
            <a class="text-link" href="/inventory/">View all vehicles <span aria-hidden="true"><Icon /></span></a>
          </div>
          <BodyTypeLinks />
        </div>
      </section>

      <section id="featured-inventory" class="section inventory-section" aria-labelledby="inventory-title">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <p class="kicker">THE COLLECTION</p>
              <h2 id="inventory-title">Featured <span>Inventory.</span></h2>
              <p class="section-intro">Take a look at our featured vehicles. Contact us for mileage, photographs, condition, and availability.</p>
            </div>
            <a class="text-link" href="#contact">Ask about a vehicle <span aria-hidden="true"><Icon /></span></a>
          </div>
          <FeaturedCarousel />
          <p class="inventory-footnote">Vehicles are subject to availability. Please contact us to confirm details and pricing.</p>
        </div>
      </section>

      <section class="manifesto" id="about" aria-labelledby="manifesto-title">
        <img class="about-backdrop" src="/gtr-about.webp" alt="" width="1600" height="900" loading="lazy" />
        <div class="wrap manifesto-grid">
          <div class="about-story">
            <p class="kicker">MORE THAN A DEALERSHIP</p>
            <h2 id="manifesto-title">A fresh start.<br />A <span>better drive.</span></h2>
            <p>Reviiv is about a fresh start and a renewed love for the road. Based in Mississauga, we're here to make finding your next vehicle feel personal, straightforward, and worth getting excited about.</p>
            <p>Real conversations. Clear answers. A team that takes the time to understand what matters to you. <strong>That's Reviiv Motors.</strong></p>
            <div class="about-credentials" aria-label="Dealer registration, membership, and vehicle history">
              <a class="credential" href="https://www.omvic.ca/dealer-search/" target="_blank" rel="noopener noreferrer">
                <span class="credential-logo"><img src="/omvic-logo.svg" alt="OMVIC" width="217" height="69" loading="lazy" /></span>
                <span>OMVIC Registered <span aria-hidden="true"><Icon /></span></span>
              </a>
              <a class="credential" href="https://www.ucda.ca/dealers/" target="_blank" rel="noopener noreferrer">
                <span class="credential-logo"><img src="/ucda-logo-monochrome.svg" alt="UCDA" width="1164" height="352" loading="lazy" /></span>
                <span>UCDA Member <span aria-hidden="true"><Icon /></span></span>
              </a>
              <a class="credential" href="https://www.carfax.ca/" target="_blank" rel="noopener noreferrer"><span class="credential-logo credential-logo-carfax"><img src="https://go.carfax.ca/hs-fs/hubfs/CARFAXCanadaLogo.png?name=CARFAXCanadaLogo.png&width=200" alt="CARFAX Canada" width="200" height="60" loading="lazy" /></span><span>Vehicle History <span aria-hidden="true"><Icon /></span></span></a>
            </div>
          </div>
        </div>
      </section>

      <section id="services" class="section services-section" aria-labelledby="services-title">
        <div class="wrap">
          <p class="kicker">WHAT WE OFFER</p>
          <h2 id="services-title">More ways to <span>drive.</span></h2>
          <a class="text-link services-page-link" href="/what-we-offer/">Get to know Reviiv <span aria-hidden="true"><Icon /></span></a>
          <div class="services-grid">
            <article class="service-card"><div class="service-heading"><div class="service-icon" aria-hidden="true"><Icon name="money" /></div><h3>Financing</h3></div><p>Ask about financing options available for your next vehicle.</p></article>
            <article class="service-card"><div class="service-heading"><div class="service-icon" aria-hidden="true"><Icon name="swap" /></div><h3>Trade-Ins</h3></div><p>Looking to make a change? Talk to us about trading in your current vehicle.</p></article>
            <article class="service-card"><div class="service-heading"><div class="service-icon" aria-hidden="true"><Icon name="shield" /></div><h3>Extended Warranties</h3></div><p>Explore available warranty options for added peace of mind.</p></article>
            <article class="service-card"><div class="service-heading"><div class="service-icon" aria-hidden="true"><Icon name="check" /></div><h3>Safety-Certified Vehicles</h3></div><p>Ask our team about vehicles available with safety certification.</p></article>
          </div>
        </div>
      </section>

      <DriveReveal />

      <section id="contact" class="section contact-section" aria-labelledby="contact-title">
        <div class="wrap">
          <div class="contact-heading">
            <p class="kicker">COME SAY HELLO</p>
            <h2 id="contact-title">Find us in <span>Mississauga.</span></h2>
            <p class="section-intro">A conversation is a great place to start. Get in touch or plan your visit.</p>
          </div>
          <div class="visit-grid">
            <div class="visit-details">
              <h3>Let's connect</h3>
              <address>
                <div class="visit-detail"><span>VISIT US</span><p>1989 Dundas Street E<br />Mississauga, Ontario</p></div>
                <div class="visit-detail"><span>GIVE US A CALL</span><a class="btn btn-primary contact-button" href="tel:+14163469568" aria-label={`Call Reviiv Motors at ${phone}`}>Call {phone} <span aria-hidden="true"><Icon /></span></a></div>
                <div class="visit-detail"><span>SEND AN EMAIL</span><p class="contact-email-address">{email}</p><a class="btn btn-outline contact-button" href={`mailto:${email}`}>Email Our Team <span aria-hidden="true"><Icon /></span></a></div>
              </address>
            </div>
            <div class="visit-hours">
              <h3>Opening hours</h3>
              {hasOpeningHours ? <>
                <table class="hours-table">
                  <caption class="sr-only">Reviiv Motors weekly opening hours</caption>
                  <tbody>{openingHours.map(({ day, hours }) => <tr><th scope="row">{day}</th><td>{hours ?? 'Please call to confirm'}</td></tr>)}</tbody>
                </table>
                <p class="hours-note">All times local to Mississauga.</p>
              </> : <div class="hours-pending"><p>Please call to confirm our opening hours and plan your visit.</p><a class="text-link" href="tel:+14163469568">Call our team <span aria-hidden="true"><Icon /></span></a></div>}
            </div>
            <div class="visit-location">
              <h3>Come find us</h3>
              <iframe class="visit-map" title="Map showing 1989 Dundas Street East, Mississauga, Ontario" src="https://maps.google.com/maps?q=1989%20Dundas%20Street%20East%2C%20Mississauga%2C%20Ontario&z=15&output=embed" width="500" height="260" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
              <a class="directions" target="_blank" rel="noopener noreferrer" href="https://www.google.com/maps/search/?api=1&query=1989+Dundas+Street+E+Mississauga+Ontario">Get Directions <span aria-hidden="true"><Icon /></span></a>
            </div>
          </div>
        </div>
      </section>
</SiteLayout>
