---
import { bodyTypes } from '../data/inventory.ts';
const { active } = Astro.props;
---
<nav class="body-types" aria-label="Browse inventory by body type">
  {bodyTypes.map((type) => (
    <a class="body-type" href={`/inventory/${type.slug}/`} aria-current={active === type.slug ? 'page' : undefined}>
      <svg viewBox="0 0 205 95" fill="none" aria-hidden="true">
        <path d={type.shape} fill="currentColor" fill-opacity=".15" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path d={type.windows} stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path d="M24 62 H181" stroke="currentColor" stroke-opacity=".3" />
        <circle cx="49" cy="72" r="12" fill="#100b19" stroke="currentColor" stroke-width="2" />
        <circle cx="155" cy="72" r="12" fill="#100b19" stroke="currentColor" stroke-width="2" />
        <circle cx="49" cy="72" r="5" stroke="currentColor" stroke-opacity=".5" />
        <circle cx="155" cy="72" r="5" stroke="currentColor" stroke-opacity=".5" />
      </svg>
      <span class="body-type-label">{type.label}<span aria-hidden="true">↗</span></span>
    </a>
  ))}
</nav>
