---
import Icon from './Icon.astro';
import { bodyTypes } from '../data/inventory.ts';
const { active } = Astro.props;
---
<nav class="body-types" aria-label="Browse inventory by body type">
  {bodyTypes.map((type) => (
    <a class="body-type" href={`/inventory/${type.slug}/`} aria-current={active === type.slug ? 'page' : undefined}>
      <span class="body-type-photo-frame"><img class="body-type-photo" src={type.image} alt={type.imageAlt} width="640" height="260" loading="lazy" decoding="async" /></span>
      <span class="body-type-label">{type.label}<span aria-hidden="true"><Icon /></span></span>
    </a>
  ))}
</nav>
