---
import VehicleCard from './VehicleCard.astro';
import { vehicles } from '../data/inventory';
---

<div class="featured-carousel" role="region" aria-roledescription="carousel" aria-label="Featured vehicles">
  <div class="carousel-track" id="featured-vehicle-track" tabindex="0" aria-label="Swipe left or use arrow keys to browse vehicles">
    {vehicles.map((car, index) => (
      <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${vehicles.length}`}>
        <VehicleCard car={car} />
      </div>
    ))}
  </div>
  <div class="carousel-controls">
    <button class="carousel-arrow carousel-prev" type="button" aria-label="Previous vehicle" aria-controls="featured-vehicle-track" disabled>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M20 12H4m7-7-7 7 7 7" /></svg>
    </button>
    <div class="carousel-pagination">
      <p class="carousel-hint">Swipe to explore</p>
      <div class="carousel-dots" aria-label="Choose a featured vehicle">
        {vehicles.map((car, index) => <button type="button" class="carousel-dot" aria-label={`Show ${car.year} ${car.make} ${car.model}`} aria-current={index === 0 ? 'true' : undefined} data-slide={index}><span></span></button>)}
      </div>
    </div>
    <button class="carousel-arrow carousel-next" type="button" aria-label="Next vehicle" aria-controls="featured-vehicle-track">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7" /></svg>
    </button>
  </div>
  <p class="sr-only carousel-status" aria-live="polite" aria-atomic="true"></p>
</div>

<style>
  .featured-carousel { max-width: 960px; margin-inline: auto; }
  .carousel-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: 10px; overscroll-behavior-x: contain; cursor: grab; }
  .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-track:focus-visible { outline: 2px solid #c084f7; outline-offset: 5px; }
  .carousel-track.is-dragging { cursor: grabbing; scroll-snap-type: none; user-select: none; }
  .carousel-slide { flex: 0 0 100%; min-width: 0; scroll-snap-align: start; scroll-snap-stop: always; padding: 1px; }
  .carousel-slide :global(.vehicle-card) { display: grid; grid-template-columns: 1.15fr 1fr; height: 100%; background: #fff; border-color: #e4dfea; color: #211929; }
  .carousel-slide :global(.vehicle-card:hover) { transform: none; }
  .carousel-slide :global(.vehicle-photo) { height: 290px; background: radial-gradient(ellipse at center, #fff, #f4f0f7); }
  .carousel-slide :global(.vehicle-index), .carousel-slide :global(.photo-note), .carousel-slide :global(.vehicle-meta) { color: #71667b; }
  .carousel-slide :global(.placeholder-wordmark) { color: #211929; }
  .carousel-slide :global(.placeholder-wordmark span) { color: #7934aa; }
  .carousel-slide :global(.vehicle-photo::after) { background: #c9b6d7; filter: none; box-shadow: none; }
  .carousel-slide :global(.vehicle-bottom) { border-color: #e4dfea; }
  .carousel-slide :global(.vehicle-bottom strong) { color: #7934aa; }
  .carousel-slide :global(.vehicle-bottom small) { color: #71667b; }
  .carousel-slide :global(.vehicle-bottom a span) { color: #7934aa; }
  .carousel-slide :global(.vehicle-info) { display: flex; flex-direction: column; justify-content: center; padding: 32px; }
  .carousel-slide :global(.vehicle-info h3) { font-size: clamp(22px, 2.6vw, 30px); margin-block: 24px 30px; }
  .carousel-slide :global(.vehicle-bottom) { flex-wrap: wrap; }
  .carousel-controls { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 18px; }
  .carousel-arrow { display: grid; place-items: center; width: 48px; height: 48px; flex: 0 0 48px; background: #201727; color: #e6c2ff; border: 1px solid #8753aa; border-radius: 50%; cursor: pointer; transition: background .2s, box-shadow .2s; }
  .carousel-arrow svg { width: 22px; height: 22px; stroke-linecap: round; stroke-linejoin: round; }
  .carousel-arrow:hover:not(:disabled) { background: #713b94; }
  .carousel-arrow:disabled { opacity: .3; cursor: default; }
  .carousel-arrow:focus-visible, .carousel-dot:focus-visible { outline: 2px solid #e6c2ff; outline-offset: 3px; }
  .carousel-pagination { text-align: center; }
  .carousel-hint { display: flex; align-items: center; justify-content: center; gap: 9px; margin: 0; font-size: 11px; color: #cbb4da; }
  .carousel-hint svg { width: 17px; height: 17px; }
  .carousel-dots { display: flex; justify-content: center; }
  .carousel-dot { width: 32px; height: 32px; display: grid; place-items: center; padding: 0; border: 0; background: transparent; cursor: pointer; border-radius: 50%; }
  .carousel-dot span { width: 7px; height: 7px; background: #655b6c; border-radius: 50%; transition: background .2s, transform .2s; }
  .carousel-dot[aria-current="true"] span { background: #d59eff; transform: scale(1.35); box-shadow: 0 0 10px #bc7fe750; }
  .is-discovered:not(.has-interacted) .carousel-next { animation: arrow-highlight 1.2s ease-in-out 3; }
  @keyframes arrow-highlight { 50% { background: #8546af; box-shadow: 0 0 0 7px #b868ee20, 0 0 24px #b868ee50; } }
  @media (max-width: 700px) {
    .carousel-slide :global(.vehicle-card) { display: block; }
    .carousel-slide :global(.vehicle-photo) { height: 220px; }
    .carousel-slide :global(.vehicle-info) { padding: 22px; }
    .carousel-slide :global(.vehicle-info h3) { font-size: 23px; margin-block: 18px 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-discovered:not(.has-interacted) .carousel-next { animation: none; background: #713b94; }
    .carousel-arrow, .carousel-dot span { transition: none; }
  }
</style>

<script>
  const carousel = document.querySelector<HTMLElement>('.featured-carousel');
  if (carousel) {
    const track = carousel.querySelector<HTMLElement>('.carousel-track')!;
    const slides = [...carousel.querySelectorAll<HTMLElement>('.carousel-slide')];
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot')];
    const previous = carousel.querySelector<HTMLButtonElement>('.carousel-prev')!;
    const next = carousel.querySelector<HTMLButtonElement>('.carousel-next')!;
    const status = carousel.querySelector<HTMLElement>('.carousel-status')!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    const interact = () => carousel.classList.add('has-interacted');
    const goTo = (index: number) => {
      interact();
      track.scrollTo({ left: Math.max(0, Math.min(slides.length - 1, index)) * track.clientWidth, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
    };
    const update = () => {
      const index = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / track.clientWidth)));
      dots.forEach((dot, i) => i === index ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current'));
      slides.forEach((slide, i) => { slide.inert = i !== index; });
      previous.disabled = index === 0;
      next.disabled = index === slides.length - 1;
      if (current !== index) status.textContent = `Vehicle ${index + 1} of ${slides.length}: ${slides[index].querySelector('h3')?.textContent}`;
      current = index;
    };
    previous.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(current + (event.key === 'ArrowRight' ? 1 : -1));
      }
    });
    let drag: { x: number; left: number; moved: boolean } | null = null;
    track.addEventListener('pointerdown', (event) => {
      interact();
      if (event.pointerType !== 'mouse' || event.button !== 0 || (event.target as HTMLElement).closest('a,button')) return;
      drag = { x: event.clientX, left: track.scrollLeft, moved: false };
      track.classList.add('is-dragging');
      track.setPointerCapture(event.pointerId);
    });
    track.addEventListener('pointermove', (event) => {
      if (!drag) return;
      const delta = event.clientX - drag.x;
      if (Math.abs(delta) > 5) drag.moved = true;
      track.scrollLeft = drag.left - delta;
    });
    const finishDrag = () => {
      if (!drag) return;
      const delta = track.scrollLeft - drag.left;
      const start = Math.round(drag.left / track.clientWidth);
      drag = null;
      track.classList.remove('is-dragging');
      goTo(start + (Math.abs(delta) > track.clientWidth * .15 ? Math.sign(delta) : 0));
    };
    track.addEventListener('pointerup', finishDrag);
    track.addEventListener('pointercancel', finishDrag);
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        carousel.classList.add('is-discovered');
        observer.disconnect();
      }
    }, { threshold: .75 });
    observer.observe(next);
    new ResizeObserver(() => {
      track.scrollTo({ left: current * track.clientWidth, behavior: 'instant' });
      update();
    }).observe(track);
    update();
  }
</script>
